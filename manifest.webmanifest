{
  "id": "./",
  "name": "MyTube Vault",
  "short_name": "MyTube Vault",
  "description": "Playlist YouTube pribadi yang tidak bergantung akun YouTube, dengan auto-backup ke GitHub Gist.",
  "lang": "id",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f1115",
  "theme_color": "#0f1115",
  "categories": ["music", "entertainment", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "share_title", "text": "share_text", "url": "share_url" }
  },
  "shortcuts": [
    { "name": "Tambah video", "short_name": "Tambah", "url": "./?action=add", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Favorit", "short_name": "Favorit", "url": "./?view=favorites", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
